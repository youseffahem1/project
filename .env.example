# --- App / DB (existing, unrelated to this change) ---
APP_SECRET_KEY=change_this_in_production

# DATABASE_URL — LOCAL DEV DEFAULT is SQLite (shown below). For Render/any
# real deployment, set this to your PostgreSQL connection string instead —
# see README.md "Deploying on Render" for exact steps. If DATABASE_URL
# starts with "postgres://" (Render's own format), the app rewrites it to
# "postgresql://" automatically — you don't need to edit it by hand.
DATABASE_URL=sqlite:///./luckyspin.db

# --- TRON Mainnet ---
TRON_NETWORK=mainnet
TRON_API_URL=https://api.trongrid.io
TRON_RPC_URL=

# BIP39 mnemonic (12/24 words) used ONLY to derive user deposit addresses.
# NEVER commit a real value here. NEVER log it. NEVER return it from any API.
TRON_MASTER_SEED=

# Dedicated withdrawal hot wallet — separate from the deposit HD wallet above.
# This is TRON MAINNET — fund it with REAL TRX, not testnet/faucet funds.
TRON_WITHDRAWAL_ADDRESS=
TRON_WITHDRAWAL_PRIVATE_KEY=

# Get a free key at https://www.trongrid.io — effectively required on
# Mainnet for reasonable rate limits (was optional back on Nile testnet).
TRONGRID_API_KEY=

TRON_MIN_CONFIRMATIONS=1
TRON_POLL_INTERVAL_SECONDS=30

# --- Outbound email (Resend HTTPS API — NOT SMTP; Render Free blocks
#     outbound SMTP ports like 587/465, so smtplib no longer works there) ---
# Free key at https://resend.com
RESEND_API_KEY=
# Sender shown as "From" — must be on a domain verified in Resend, or their
# onboarding sender while testing, e.g.: LuckySpin <onboarding@resend.dev>
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=vibeainlo@gmail.com

# --- Admin notification emails (signup / confirmed deposit / withdrawal / Nigerian deposit) ---
# Reuses RESEND_API_KEY/EMAIL_FROM above. Optional — defaults to the address below if unset.
ADMIN_EVENTS_EMAIL=luckyspin.notifications@gmail.com
